---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found | Startup Founders Toolkit"
  noindex
  bodyClass="min-h-screen bg-primary-900 text-white antialiased flex items-center justify-center px-4"
>
  <main class="text-center max-w-md">
    <p class="text-accent-500 font-bold tracking-wider uppercase mb-4">404</p>
    <h1 class="text-4xl font-extrabold mb-4">This page has flown off course.</h1>
    <p class="text-blue-100 mb-8">The page you were looking for doesn't exist or has moved.</p>
    <a href="/" class="inline-block bg-accent-500 hover:bg-accent-600 text-primary-900 px-8 py-4 rounded-md font-bold transition-colors">Back to home</a>
  </main>
</BaseLayout>
