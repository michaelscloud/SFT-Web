---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { TURNSTILE_SITE_KEY } from '../config.mjs';
---
<BaseLayout
  title="Startup Founders Toolkit | Fractional C-suite expertise for founders"
  description="Flexible, fractional C-suite leadership and operational tools for startup founders, scaleups and their investors — without the £150k+ overhead."
  path="/"
  og={{
    title: 'Startup Founders Toolkit — Instant expertise for founders & their funders',
    description: 'Fractional C-suite leadership and operational tools, without the £150k+ overhead.',
  }}
  themeColor="#1e3a8a"
  htmlClass="scroll-smooth"
  bodyClass="min-h-screen bg-slate-50 text-slate-800 antialiased"
  preloadFonts
  interactive
>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:text-primary-900 focus:px-4 focus:py-2 focus:rounded-md">Skip to content</a>

  <Nav />

<main id="main">
  <!-- Hero -->
  <section id="home" class="relative text-white pt-40 pb-20 lg:pt-52 lg:pb-32 overflow-hidden">
    <img class="absolute inset-0 w-full h-full object-cover" src="/images/hero.svg" alt="" fetchpriority="high" width="1920" height="1080">
    <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <p class="text-accent-500 font-bold tracking-wider uppercase mb-4">Reach new heights</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">Instant Expertise, Tailored for Founders &amp; Their Funders.</h1>
        <p class="text-lg sm:text-xl text-blue-100 mb-8 leading-relaxed">Bridging the gap between startup ambition and execution. We provide flexible, fractional C-suite leadership and operational tools without the £150k+ overhead.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="bg-accent-500 hover:bg-accent-600 text-primary-900 text-center px-8 py-4 rounded-md font-bold text-lg transition-colors">Get in Touch</a>
          <a href="#tools" class="border-2 border-white hover:bg-white hover:text-primary-900 text-center px-8 py-4 rounded-md font-bold text-lg transition-colors">View The Toolkit (Soon)</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-primary-900 mb-4">Helping Startups &amp; Scaleups Soar</h2>
        <p class="text-lg text-slate-600">Most founders don't fail because they lack vision; they fail because they lack the senior-level hands to turn that vision into a repeatable machine. SFT is that machine.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
          <div class="w-12 h-12 bg-blue-100 text-primary-900 rounded-lg flex items-center justify-center mb-6"><Icon name="brain-circuit" /></div>
          <h3 class="text-xl font-bold text-primary-900 mb-3">Beat Founder Burnout</h3>
          <p class="text-slate-600">52% of founders report burnout caused by the cognitive load of "unpredictable chaos". We provide an outsider's lens to identify blind spots you're too close to see.</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
          <div class="w-12 h-12 bg-blue-100 text-primary-900 rounded-lg flex items-center justify-center mb-6"><Icon name="wallet" /></div>
          <h3 class="text-xl font-bold text-primary-900 mb-3">Close the Overhead Gap</h3>
          <p class="text-slate-600">Founders often wait too long to hire C-suite leaders because of the £150k+ cost. We fill the leadership void instantly without the permanent overhead.</p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
          <div class="w-12 h-12 bg-blue-100 text-primary-900 rounded-lg flex items-center justify-center mb-6"><Icon name="hammer" /></div>
          <h3 class="text-xl font-bold text-primary-900 mb-3">Execution Over Theory</h3>
          <p class="text-slate-600">Unlike traditional consultants who just provide advice, SFT is about embedded capability. We are a flexible extension of your team, focused on delivery.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Serve -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary-900 mb-12 text-center">Who We Serve</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border-t-4 border-accent-500 pt-6">
          <h3 class="text-2xl font-bold text-slate-800 mb-1">Startup Founders</h3>
          <p class="text-slate-500 mb-4 font-medium">Early &amp; Growth Stage</p>
          <p class="text-slate-600">For those at the helm navigating scaling chaos, leadership voids, and fundraising hurdles. We provide on-demand expertise to overcome hurdles and build repeatable machines.</p>
        </div>
        <div class="border-t-4 border-primary-700 pt-6">
          <h3 class="text-2xl font-bold text-slate-800 mb-1">Scaleup Businesses</h3>
          <p class="text-slate-500 mb-4 font-medium">Rapid Growth Stage</p>
          <p class="text-slate-600">Experiencing rapid growth but noticing system cracks and operational friction? We help you build robust, specialised systems to sustain long-term momentum.</p>
        </div>
        <div class="border-t-4 border-slate-400 pt-6">
          <h3 class="text-2xl font-bold text-slate-800 mb-1">PE &amp; VC Firms</h3>
          <p class="text-slate-500 mb-4 font-medium">Investors</p>
          <p class="text-slate-600">Mitigate execution risk and portfolio inefficiency. We offer reliable, high-quality operational support to ensure capital builds robust systems, enhancing portfolio value.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="py-20 bg-blue-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold text-primary-900 mb-4">Calculate Your Overhead Savings</h2>
          <p class="text-slate-600 mb-8">See how much you can save by leveraging SFT's fractional experts instead of committing to full-time C-suite salaries. Select the roles you need:</p>
          <fieldset class="space-y-3">
            <legend class="sr-only">Roles you need</legend>
            <label class="flex items-center p-4 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-primary-900 transition-colors">
              <input type="checkbox" class="calc-checkbox w-5 h-5 accent-primary-900" value="150000">
              <span class="ml-3 font-semibold text-slate-700">Fractional CEO / COO (£150,000/yr full-time)</span>
            </label>
            <label class="flex items-center p-4 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-primary-900 transition-colors">
              <input type="checkbox" class="calc-checkbox w-5 h-5 accent-primary-900" value="120000">
              <span class="ml-3 font-semibold text-slate-700">Fractional CMO (£120,000/yr full-time)</span>
            </label>
            <label class="flex items-center p-4 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-primary-900 transition-colors">
              <input type="checkbox" class="calc-checkbox w-5 h-5 accent-primary-900" value="110000">
              <span class="ml-3 font-semibold text-slate-700">Fractional HR Director (£110,000/yr full-time)</span>
            </label>
            <label class="flex items-center p-4 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-primary-900 transition-colors">
              <input type="checkbox" class="calc-checkbox w-5 h-5 accent-primary-900" value="130000">
              <span class="ml-3 font-semibold text-slate-700">Fractional CFO (£130,000/yr full-time)</span>
            </label>
          </fieldset>
        </div>
        <div class="lg:w-1/2 w-full">
          <div class="bg-primary-900 text-white p-8 rounded-2xl shadow-xl text-center relative overflow-hidden" aria-live="polite">
            <div class="absolute top-0 right-0 w-32 h-32 bg-accent-500 rounded-bl-full opacity-20" aria-hidden="true"></div>
            <h3 class="text-xl font-bold mb-6 text-blue-100">Estimated Annual Cost Comparison</h3>
            <div class="flex justify-between items-end gap-4 mb-4 border-b border-primary-700 pb-4">
              <div class="text-left">
                <p class="text-sm text-blue-200 mb-1">Traditional Full-Time</p>
                <p class="text-2xl sm:text-3xl font-bold text-slate-300 line-through">£<span id="calc-ft-cost">0</span></p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-accent-500 uppercase tracking-widest mb-1">SFT Fractional</p>
                <p class="text-3xl sm:text-4xl font-extrabold text-white">£<span id="calc-sft-cost">0</span><span class="text-lg font-normal text-blue-200">/yr*</span></p>
              </div>
            </div>
            <div class="bg-white/10 p-4 rounded-lg mt-6">
              <p class="text-lg">Your Estimated Savings: <span class="font-bold text-accent-500 text-2xl ml-2">£<span id="calc-savings">0</span></span></p>
            </div>
            <p class="text-xs text-blue-300 mt-4">*Based on an average fractional engagement. Costs are strictly tailored to your specific scaling needs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Diagnostic Quiz -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-primary-900 mb-4">What's Stopping Your Growth?</h2>
      <p class="text-slate-600 mb-10">Select your biggest current friction point to see which SFT expertise pillar you need.</p>
      <div class="bg-slate-50 p-6 sm:p-8 rounded-xl border border-slate-200">
        <div id="quiz-questions" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="strategy">Lack of clear direction or stalling business plan</button>
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="ops">Systems breaking under the weight of scaling</button>
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="marketing">Struggling to acquire customers predictably</button>
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="people">High turnover or struggling to recruit top talent</button>
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="sales">Sales process is inconsistent or unpredictable</button>
          <button type="button" class="quiz-btn p-4 bg-white border border-slate-200 rounded-lg hover:border-accent-500 hover:shadow-md transition-all text-left font-semibold text-slate-700" data-result="finance">Running out of cashflow or needing to fundraise</button>
        </div>
        <div id="quiz-result" class="hidden p-6 bg-blue-50 border border-blue-100 rounded-lg text-left" aria-live="polite" tabindex="-1">
          <h3 class="text-xl font-bold text-primary-900 mb-2">Your Recommended Solution: <span id="quiz-result-title" class="text-accent-700"></span></h3>
          <p id="quiz-result-text" class="text-slate-600 mb-4"></p>
          <div class="flex flex-wrap items-center gap-4">
            <button id="quiz-reset" type="button" class="text-sm font-semibold text-slate-500 hover:text-primary-900 underline">Start Over</button>
            <a href="#contact" class="bg-primary-900 hover:bg-primary-800 text-white px-5 py-2 rounded-md font-semibold transition-colors text-sm">Book Free Briefing</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Grid -->
  <section id="expertise" class="py-20 bg-primary-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="text-accent-500 font-bold uppercase tracking-wider mb-2">Our Fractional Expertise</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Whatever your challenge, we have experts who can help.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="map" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">Strategy</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Strategic Partner Review</li><li>Business Plans &amp; Pitch Decks</li><li>Strategy on a Page</li><li>Performance Metrics &amp; Comms</li><li>AI Implementation</li>
          </ul>
        </div>
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="settings-2" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">Operations</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Legal &amp; Risk Management</li><li>Demand Forecasting</li><li>Data Security &amp; Protection</li><li>Project Management</li><li>AI Implementation</li>
          </ul>
        </div>
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="megaphone" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">Brand &amp; Marketing</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Audience &amp; Persona Mapping</li><li>SEO / PPC / Email Campaigns</li><li>Content Planning &amp; Automation</li><li>Brand Impact Strategy</li>
          </ul>
        </div>
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="users" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">People (HR &amp; Talent)</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Org Design &amp; Culture Repair</li><li>Hiring Roadmaps</li><li>Onboarding &amp; Integration Systems</li><li>Performance Scorecards</li>
          </ul>
        </div>
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="trending-up" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">Sales</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Go-to-Market (GTM) Strategy</li><li>Pricing Models</li><li>Gated Sales Process</li><li>Commission Structures</li>
          </ul>
        </div>
        <div class="bg-primary-800 p-6 rounded-lg border border-primary-700 hover:border-accent-500 transition-colors">
          <Icon name="chart-pie" class="w-8 h-8 text-accent-500 mb-4" />
          <h3 class="text-xl font-bold mb-3">Finance</h3>
          <ul class="pillar-list text-blue-100 text-sm space-y-1">
            <li>Fundraising (EIS/SEIS)</li><li>Cashflow &amp; Management Reports</li><li>Banking/Investor Relations</li><li>Mitigating Financial Risks</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Directors -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary-900 mb-2 text-center">Meet the Directors</h2>
      <p class="text-center text-slate-600 mb-12 max-w-2xl mx-auto">Cross-sector thought leadership and execution credibility. We don't just advise; we embed into your team and get it done.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl border border-slate-200 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full mb-4 overflow-hidden border-4 border-blue-50">
            <img class="w-full h-full object-cover grayscale" loading="lazy" src="/images/director-rob-kerner.svg" alt="Rob Kerner" width="192" height="192">
          </div>
          <h3 class="font-bold text-lg text-primary-900">Rob Kerner</h3>
          <p class="text-sm font-semibold text-accent-700 mb-3">Fractional CEO &amp; Ops</p>
          <p class="text-sm text-slate-600">Background in RBS, HP, and the US Navy. Brings transformative growth strategies and operational power tools to ambitious businesses.</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-slate-200 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full mb-4 overflow-hidden border-4 border-blue-50">
            <img class="w-full h-full object-cover grayscale" loading="lazy" src="/images/director-jonathan-evans.svg" alt="Jonathan Evans" width="192" height="192">
          </div>
          <h3 class="font-bold text-lg text-primary-900">Jonathan Evans</h3>
          <p class="text-sm font-semibold text-accent-700 mb-3">Marketing &amp; Copywriting</p>
          <p class="text-sm text-slate-600">Decade of experience building recruitment functions. Specialises in highly effective, efficient ways to reach target audiences.</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-slate-200 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full mb-4 overflow-hidden border-4 border-blue-50">
            <img class="w-full h-full object-cover" loading="lazy" src="/images/director-caroline-hall.svg" alt="Caroline Hall" width="192" height="192">
          </div>
          <h3 class="font-bold text-lg text-primary-900">Caroline Hall</h3>
          <p class="text-sm font-semibold text-accent-700 mb-3">Talent Acquisition</p>
          <p class="text-sm text-slate-600">Managing Director of The Small Consultancy. Wealth of recruitment experience with private equity-backed scaleups and startups.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools Coming Soon -->
  <section id="tools" class="py-20 bg-white relative overflow-hidden">
    <div class="absolute right-0 top-0 w-1/2 h-full bg-gradient-to-l from-orange-50 to-transparent" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-primary-900 rounded-2xl overflow-hidden shadow-2xl flex flex-col lg:flex-row">
        <div class="lg:w-1/2 p-8 sm:p-10 lg:p-16 flex flex-col justify-center">
          <span class="inline-block bg-accent-500 text-primary-900 font-bold text-xs uppercase tracking-widest py-1 px-3 rounded-full w-max mb-6">Coming Soon</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">The SFT Knowledge Hub &amp; Tools</h2>
          <p class="text-blue-100 text-lg mb-8">We are currently building the ultimate toolkit for founders. Soon, you'll be able to access our comprehensive suite of resources:</p>
          <ul class="text-white space-y-4">
            <li class="flex items-start gap-3"><Icon name="circle-check" class="flex-shrink-0 text-accent-500" /><span><strong>Free Gated Templates:</strong> Essential documents to scale.</span></li>
            <li class="flex items-start gap-3"><Icon name="circle-check" class="flex-shrink-0 text-accent-500" /><span><strong>Premium Content:</strong> Webinars, videos, and in-depth guides.</span></li>
            <li class="flex items-start gap-3"><Icon name="circle-check" class="flex-shrink-0 text-accent-500" /><span><strong>Community:</strong> Private spaces to connect with other founders.</span></li>
          </ul>
        </div>
        <div class="lg:w-1/2 bg-blue-800 p-8 sm:p-10 lg:p-16 flex items-center justify-center">
          <div class="bg-white p-8 rounded-xl w-full max-w-md text-center">
            <div class="w-16 h-16 bg-orange-100 text-accent-700 rounded-full flex items-center justify-center mx-auto mb-4"><Icon name="mail" /></div>
            <h3 class="text-xl font-bold text-primary-900 mb-2">Join the Waitlist</h3>
            <p class="text-sm text-slate-600 mb-6">Be the first to know when the tools drop, and get early access to our free templates.</p>
            <form class="js-form flex flex-col gap-3 text-left" action="/api/contact" method="post" novalidate>
              <input type="hidden" name="type" value="waitlist">
              <!-- The waitlist exists to email people, so joining it is the marketing opt-in -->
              <input type="hidden" name="marketing_opt_in" value="on">
              <div class="hp-field" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
              <label for="waitlist-email" class="sr-only">Work email</label>
              <input id="waitlist-email" name="email" type="email" required autocomplete="email" placeholder="Your work email" class="w-full px-4 py-3 border border-slate-300 rounded-md focus:outline-none focus:border-primary-900 focus:ring-1 focus:ring-primary-900">
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible"></div>
              <button type="submit" class="w-full bg-primary-900 hover:bg-primary-800 text-white font-bold py-3 rounded-md transition-colors disabled:opacity-60">Notify Me</button>
              <p class="text-xs text-slate-500">We'll only email you about the toolkit. Unsubscribe any time. See our <a href="/privacy" class="underline hover:text-primary-900">privacy policy</a>.</p>
              <p class="form-status hidden text-sm font-semibold" role="status"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Timeline -->
  <section id="process" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-primary-900 mb-4">The SFT Engagement Process</h2>
        <p class="text-slate-600 text-lg">A transparent, structured approach to assessing your needs and building your path to growth.</p>
      </div>
      <div class="max-w-4xl mx-auto relative">
        <div class="absolute top-8 left-0 w-full h-1 bg-slate-200 rounded-full" aria-hidden="true">
          <div id="timeline-progress" class="h-full bg-accent-500 w-[12.5%] transition-all duration-500 ease-in-out rounded-full"></div>
        </div>
        <div class="flex justify-between relative z-10">
          <button type="button" class="timeline-step flex flex-col items-center w-1/4" data-step="1" aria-controls="step-content-1" aria-current="step">
            <span class="step-indicator w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl font-bold border-4 border-white transition-all duration-300">1</span>
            <span class="step-label mt-4 font-bold text-sm md:text-base">Briefing</span>
          </button>
          <button type="button" class="timeline-step flex flex-col items-center w-1/4" data-step="2" aria-controls="step-content-2">
            <span class="step-indicator w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl font-bold border-4 border-white transition-all duration-300">2</span>
            <span class="step-label mt-4 font-bold text-sm md:text-base">Triage</span>
